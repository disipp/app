{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ce64181a-14aa-4db8-8984-5461e4aa7a04","database_name": "web-app1111" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "27d009f4425d4f8eb096a56ac3a2f9e5" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
